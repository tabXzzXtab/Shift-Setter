{
  "name": "shift-setter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "types:gen": "node scripts/gen-types.mjs",
    "db:sql": "node scripts/sql.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:db": "node scripts/test-db.mjs",
    "db:validate": "node scripts/validate-migration.mjs",
    "db:snapshot": "node scripts/schema-check.mjs --write",
    "db:check": "node scripts/schema-check.mjs",
    "walkthrough": "node scripts/walkthrough.mjs",
    "test:race": "node scripts/race-test.mjs",
    "walkthrough:tiers": "node scripts/walkthrough-tiers.mjs",
    "walkthrough:batch": "node scripts/walkthrough-batch.mjs",
    "check:print-colour": "node scripts/print-colour-check.mjs",
    "walkthrough:snabb": "node scripts/walkthrough-snabb.mjs",
    "demo:accounts": "node scripts/demo-accounts.mjs",
    "demo:reset": "npm run db:sql -- --file supabase/maintenance/reset-demo-data.sql && npm run demo:accounts",
    "check:pdf-download": "node scripts/pdf-download-check.mjs",
    "walkthrough:kalender": "node scripts/walkthrough-kalender.mjs",
    "walkthrough:brist": "node scripts/walkthrough-brist.mjs",
    "walkthrough:admin": "node scripts/walkthrough-admin.mjs",
    "walkthrough:ledare": "node scripts/walkthrough-ledare.mjs",
    "walkthrough:arbetare": "node scripts/walkthrough-arbetare.mjs",
    "walkthrough:avboka": "node scripts/walkthrough-avboka.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.113.0",
    "leaflet": "^1.9.4",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
