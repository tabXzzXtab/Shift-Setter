{
  "name": "shift-setter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "types:gen": "node scripts/gen-types.mjs",
    "db:sql": "node scripts/sql.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:db": "node scripts/test-db.mjs",
    "db:validate": "node scripts/validate-migration.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.113.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}