# ---- Supabase project (client, safe to expose) ----
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_PUBLIC_KEY>

# ---- Supabase CLI (never exposed to the browser) ----
SUPABASE_PROJECT_REF=<PROJECT_REF>
SUPABASE_ACCESS_TOKEN=<PERSONAL_ACCESS_TOKEN>

# ---- Direct database connection, for running arbitrary SQL in dev/test ----
# Copy verbatim from Supabase dashboard -> Connect -> ORM/psql.
# Password percent-encoded if it contains  @ : / ? # [ ] % &
SUPABASE_DB_PASSWORD=<DB_PASSWORD>
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
