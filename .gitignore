# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- .env.local holds the db password and access token. Never commit.
.env*
!.env.local.example

# supabase cli scratch
supabase/.temp
supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts

# large binaries / customer documents
*.pdf
*.zip
artifacts/
