# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- .env.local holds the db password and access token. Never commit.
.env*
!.env.local.example

# supabase cli scratch
supabase/.temp
supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts

# large binaries / customer documents
*.pdf
*.zip
artifacts/

# Reference photography and captured screens -- megabytes of JPEG/PNG that are
# working material, not product. The repo is public and git history is
# permanent, so an accidental `git add -A` here would publish a customer's
# photographs for good. The handoff in handoff/ is the tracked design source.
design/
screenshots/

# Throwaway logins, one per role, minted with the service-role key. Kept out of
# the repo on purpose: it is a local convenience, not part of the product, and
# an accidental `git add -A` should not put a credential-minting script for the
# admin role into a public repository. scripts/demo-accounts.mjs is the tracked
# one -- those logins are handed to people and have to survive a demo reset.
scripts/temp-accounts.mjs

# Capacitor native shells, regenerated by `npx cap add ios` / `cap add android`
# from capacitor.config.ts, which IS tracked. Two Xcode/Gradle trees are tens of
# megabytes of template the repo would carry forever.
#
# THE COST IS REAL AND WORTH KNOWING: anything hand-edited inside these folders
# is untracked and is lost on a fresh clone -- Info.plist permission strings,
# AndroidManifest entries, app icons, splash screens and signing config all
# live in here. Capacitor's own guidance is to commit them for exactly that
# reason. As long as they stay ignored, every such edit has to be reproducible
# from something that is tracked, or it will be made once and silently
# disappear the next time somebody runs `cap add`.
ios/
android/
